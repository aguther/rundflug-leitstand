{
  "name": "rundflug-leitstand",
  "version": "1.12.0",
  "private": true,
  "description": "Cloudflare-native start repository for the Rundflug-Leitstand.",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=12.0.2 <13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:web && concurrently --kill-others --names web,worker --prefix-colors cyan,magenta \"npm run dev:web\" \"npm run dev:worker\"",
    "dev:web": "npm run dev -w @rundflug/web",
    "dev:worker": "npm run dev -w @rundflug/worker",
    "simulator": "npm run simulator -w @rundflug/web",
    "build": "npm run typecheck && npm run build:web && npm run build:worker",
    "build:web": "npm run build -w @rundflug/web",
    "build:web:bundle": "npm run build:bundle -w @rundflug/web",
    "web:assets:report": "npm run assets:report -w @rundflug/web",
    "web:assets:verify": "node scripts/verify_web_assets.mjs",
    "build:worker": "npm run build -w @rundflug/worker",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:ci": "vitest run apps/worker/src/maintainability-coverage.test.ts packages/contracts/src/index.test.ts packages/domain/src/index.test.ts apps/web/src/api.test.ts",
    "test:coverage": "vitest run --coverage --testNamePattern=\"^(?!.*projects all 300 eligible groups beyond the bounded dispatch horizon).*$\" && node scripts/verify_domain_coverage.mjs",
    "test:forecast-comparison-baseline": "vitest run --config vitest.forecast-baseline.config.ts",
    "test:mutation": "stryker run && node scripts/verify_mutation_report.mjs",
    "test:mutation:dry": "stryker run --dryRunOnly",
    "test:outage-recovery": "node scripts/verify_outage_recovery.mjs",
    "test:emergency-mode": "node scripts/verify_emergency_mode.mjs",
    "test:master-data": "node scripts/verify_master_data.mjs",
    "test:fleet-operations": "node scripts/verify_fleet_operations.mjs",
    "test:recurring-operational-rules": "node scripts/verify_recurring_operational_rules.mjs",
    "test:ticket-corrections": "node scripts/verify_ticket_corrections.mjs",
    "test:sale-guards": "node scripts/verify_sale_guards.mjs",
    "test:queue-grouping": "node scripts/verify_queue_grouping.mjs",
    "test:pilot-conflict": "node scripts/verify_pilot_conflict.mjs",
    "test:ticket-assignment-concurrency": "node scripts/verify_ticket_assignment_concurrency.mjs",
    "test:ticket-deferrals": "node scripts/verify_ticket_deferrals.mjs",
    "test:ticket-group-recall": "node scripts/verify_ticket_group_recall.mjs",
    "test:automatic-precall": "node scripts/verify_automatic_precall.mjs",
    "test:first-run-setup": "node scripts/verify_first_run_setup.mjs",
    "test:factory-reset": "node scripts/verify_factory_reset.mjs",
    "test:factory-reset:production-scale": "node scripts/verify_factory_reset.mjs --production-scale",
    "test:public-monitors": "node scripts/verify_public_monitors.mjs",
    "test:vertical-slice": "node scripts/verify_vertical_slice.mjs",
    "test:v1-acceptance-day": "node scripts/verify_v1_acceptance_day.mjs",
    "test:scale-performance": "node scripts/verify_scale_performance.mjs",
    "test:cloudflare-scale-performance": "node scripts/verify_cloudflare_scale_performance.mjs",
    "test:soak-reliability": "node scripts/verify_soak_reliability.mjs",
    "test:cloudflare-availability": "node scripts/verify_cloudflare_availability.mjs",
    "test:worker-runtime": "vitest run --config vitest.worker.config.ts",
    "analysis:replay": "node scripts/replay_analysis_package.mjs",
    "planning-history:restore": "node scripts/restore_planning_history.mjs",
    "test:planning-history-restore": "node scripts/verify_planning_history_restore.mjs",
    "test:planning-history-scale": "node scripts/verify_planning_history_scale.mjs",
    "test:planning-history-scale:full": "node scripts/verify_planning_history_scale.mjs --full",
    "sonar": "npm run test:coverage && sonar-scanner-npm",
    "test:analysis-replay": "node scripts/verify_analysis_replay.mjs",
    "test:analysis-scale": "node scripts/verify_analysis_capture_scale.mjs",
    "test:browser:roles": "node scripts/capture_role_guides.mjs",
    "test:browser:cashier": "node scripts/verify_cashier_browser.mjs",
    "test:browser:error-boundaries": "node scripts/verify_error_boundaries_browser.mjs",
    "test:browser:event-switch": "node scripts/verify_event_switch_browser.mjs",
    "test:v1-integrations": "node scripts/verify_v1_integrations.mjs",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome format --write .",
    "refactor:guardrails": "node scripts/verify_refactor_guardrails.mjs && node scripts/verify_worker_sql_test_oracles.mjs",
    "check:ci": "npm run lint && npm run refactor:guardrails && npm run cloudflare:maintenance && npm run typecheck && npm run test:ci && npm run build:web && npm run build:worker && npm run test:planning-history-restore && npm run test:planning-history-scale && npm run requirements:verify",
    "check": "npm run lint && npm run refactor:guardrails && npm run cloudflare:maintenance && npm run typecheck && npm run test && npm run build:web:bundle && npm run build:worker && npm run test:analysis-replay && npm run test:analysis-scale && npm run test:planning-history-restore && npm run test:planning-history-scale && npm run test:worker-runtime && npm run test:v1-integrations && npm run test:v1-acceptance-day && npm run backup:restore:test && npm run docs:verify && npm run requirements:verify",
    "backup:restore:test": "python3 scripts/verify_backup_restore.py",
    "docs:verify": "node scripts/verify_architecture_docs.mjs && npm run docs:arc42:check && npm run docs:requirements:check && npm run docs:migrations:check && npm run docs:licenses:check && npm run docs:guides:check",
    "docs:guides:build": "node scripts/run_role_guides.mjs build",
    "docs:guides:check": "node scripts/run_role_guides.mjs check",
    "docs:migrations:build": "node scripts/verify_migrations.mjs --write",
    "docs:migrations:check": "node scripts/verify_migrations.mjs",
    "docs:licenses:build": "node scripts/verify_license_inventory.mjs --write",
    "docs:licenses:check": "node scripts/verify_license_inventory.mjs",
    "docs:requirements:build": "python3 scripts/generate_current_requirements.py --write",
    "docs:requirements:check": "python3 scripts/generate_current_requirements.py",
    "requirements:verify": "python3 scripts/verify_requirements.py",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:migrations:remote:status": "wrangler d1 migrations list DB --remote --config wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "db:seed:local": "wrangler d1 execute DB --local --file apps/worker/seed/demo.sql --config wrangler.jsonc",
    "db:reset:local": "node scripts/reset_local_db.mjs",
    "db:reset:empty-local": "node scripts/reset_local_db.mjs --empty",
    "deploy": "npm run build:web && wrangler deploy --config wrangler.jsonc",
    "cloudflare:configure-setup": "node scripts/configure_cloudflare_setup.mjs",
    "cloudflare:configure-push": "node scripts/configure_cloudflare_push.mjs",
    "cloudflare:bootstrap": "node scripts/cloudflare_bootstrap.mjs",
    "cloudflare:verify": "node scripts/cloudflare_verify.mjs",
    "cloudflare:ci-config": "node scripts/cloudflare_ci_config.mjs",
    "cloudflare:deployment-credential": "node scripts/configure_deployment_backup_secret.mjs",
    "cloudflare:preflight": "node scripts/cloudflare_preflight.mjs",
    "cloudflare:deploy": "node scripts/cloudflare_deploy.mjs",
    "cloudflare:maintenance": "node scripts/verify_cloudflare_maintenance.mjs",
    "cloudflare:recreate-d1": "node scripts/cloudflare_recreate_d1.mjs",
    "clean": "node -e \"const fs=require('node:fs'); for (const p of ['apps/web/dist','apps/worker/dist']) fs.rmSync(p,{recursive:true,force:true})\"",
    "docs:arc42:check": "node scripts/verify_arc42_docs.mjs",
    "docs:arc42:bundle": "node scripts/build_arc42_bundle.mjs",
    "docs:arc42:pdf": "playwright install chromium && node scripts/build_arc42_pdf.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "5.20260815.1",
    "@playwright/test": "^1.62.1",
    "@sonar/scan": "^5.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.33.0",
    "mermaid": "11.16.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "qs": "6.15.3",
    "shell-quote": "1.10.0"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260714.1": true,
    "workerd@1.20260801.1": true,
    "workerd@1.20260811.1": true,
    "sharp": false
  }
}

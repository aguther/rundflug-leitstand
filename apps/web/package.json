{
  "name": "@rundflug/web",
  "version": "1.12.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "simulator": "vite --mode simulator --host 127.0.0.1 --open /simulation",
    "build": "tsc --noEmit && vite build && npm run assets:verify",
    "build:bundle": "vite build && npm run assets:verify",
    "assets:report": "vite build && node ../../scripts/verify_web_assets.mjs --report-only",
    "assets:verify": "node ../../scripts/verify_web_assets.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@rundflug/config": "1.12.0",
    "@rundflug/contracts": "1.12.0",
    "@rundflug/domain": "1.12.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.31.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "workbox-window": "7.4.1"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "1.3.0"
  }
}

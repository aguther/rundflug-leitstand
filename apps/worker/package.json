{
  "name": "@rundflug/worker",
  "version": "1.12.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../../wrangler.jsonc --var APP_ENV:development --var DATA_JURISDICTION:eu",
    "build": "wrangler deploy --dry-run --outdir dist --config ../../wrangler.jsonc",
    "types:check": "wrangler types src/worker-configuration.d.ts --check --env-interface CloudflareBindings --config ../../wrangler.jsonc",
    "typecheck": "npm run types:check && tsc --noEmit"
  },
  "dependencies": {
    "@rundflug/config": "1.12.0",
    "@rundflug/contracts": "1.12.0",
    "@rundflug/domain": "1.12.0",
    "fflate": "^0.8.3",
    "hono": "^4.12.32",
    "zod": "4.4.3"
  }
}

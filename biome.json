{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.wrangler",
      "!**/.claude",
      "!wrangler.*.generated.jsonc",
      "!coverage",
      "!tmp",
      "!apps/worker/src/worker-configuration.d.ts",
      "!docs/ui/icon-system",
      "!docs/requirements/*.md",
      "!docs/requirements/*.yaml",
      "!docs/requirements/*.csv",
      "!package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
